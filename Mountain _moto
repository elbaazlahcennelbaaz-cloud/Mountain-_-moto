<script>
(function(){
 const wl=document.getElementById('wl'),un=document.getElementById('un'),wt=document.getElementById('wt');
 let saved='';try{saved=localStorage.getItem('mhc_name')||''}catch(e){}
 un.value=saved;if(saved)wt.textContent='مرحبا بيك مرة أخرى';
 function go(){
  const v=un.value.trim().slice(0,14)||'لاعب';
  uname=v;try{localStorage.setItem('mhc_name',v)}catch(e){}
  document.getElementById('hi').textContent='مرحبا '+v+' 👋';
  reset();
  wl.style.opacity=0;setTimeout(()=>{wl.style.display='none'},400);
 }
 document.getElementById('st').onclick=go;
 un.addEventListener('keydown',e=>{if(e.key==='Enter')go()});
})();
</script>
<div id="ov"><h1>موتور الجبل</h1><div id="hi"></div><p id="msg">الغاز على اليمين، الفرامل على اليسار. فالهوا الغاز كيرفع الموتور والفرامل كتنزلو.</p><div id="mn"><div id="tb"></div><div id="side"><canvas id="pv" width="240" height="110"></canvas><div class="row" id="rl"></div><div class="row" id="rb"></div><div class="row" id="rc"></div><div class="row" id="rk"></div><div class="row" id="rg"></div></div></div><button id="go">العب</button></div>
<script>
const cv=document.getElementById('c'),ctx=cv.getContext('2d');
let W,H,DPR;
function rs(){DPR=Math.min(window.devicePixelRatio||1,2);W=innerWidth;H=innerHeight;cv.width=W*DPR;cv.height=H*DPR;ctx.setTransform(DPR,0,0,DPR,0,0)}
addEventListener('resize',rs);rs();
let uname=(()=>{try{return localStorage.getItem('mhc_name')||''}catch(e){return''}})();
let G=900;const K=1500,C=60,R=13,I=500;
const COLORS=['#d9531e','#c8341e','#e8b923','#3a8f4c','#2b7fd1','#7b4fc9','#e85a9a','#2b2b2b'];
const BIKES=[{n:'كلاسيك',eng:1100,max:520,I:500},{n:'سريع',eng:1500,max:700,I:420},{n:'ثقيل',eng:950,max:480,I:700},{n:'Titan',eng:1250,max:600,I:560,sh:1},{n:'Panther',eng:1650,max:760,I:400,sh:2},{n:'تشوبر',eng:1000,max:500,I:800,sh:3},{n:'كروكس',eng:1200,max:560,I:440,sh:4},{n:'Falcon',eng:1800,max:820,I:380,sh:5},{n:'Cyber',eng:1500,max:740,I:430,sh:6},{n:'Mammoth',eng:1100,max:540,I:900,sh:7},{n:'Rocket',eng:2000,max:900,I:350,sh:8}];
const CHARS=[{n:'ياسين',s:'#2b1a12',h:'#fff6e8',t:'#d9531e'},{n:'سلمى',s:'#6a2a5a',h:'#f7d3e8',t:'#e85a9a'},{n:'رائد فضاء',s:'#dfe6ee',h:'#ffffff',t:'#2b7fd1'},{n:'نينجا',s:'#161616',h:'#2a2a2a',t:'#c8341e'}];
const LEVELS=[{n:'صحرا',g:900,amp:1,tr:1,sky:['#f6c77a','#f08e55','#c4573a'],sun:'#fff0c4',far:'#b8553a',ground:'#7a3b1d',edge:'#e0a050'},{n:'تلج',g:900,amp:1.05,tr:.8,sky:['#dcebf7','#a9cbe6','#7aa5c8'],sun:'#ffffff',far:'#9ab8d0',ground:'#e4eef5',edge:'#ffffff'},{n:'غابة',g:900,amp:1.25,tr:1,sky:['#c9e8a8','#86c77f','#3f8f5b'],sun:'#fffbd0',far:'#2f6b44',ground:'#4a3320',edge:'#62b04c'},{n:'القمر',g:450,amp:1.1,tr:1,sky:['#080c26','#1c2a5e','#3b4a8a'],sun:'#e8ecff',far:'#4a5380',ground:'#8d8f9c',edge:'#cfd2e0'}];
const cfg=Object.assign({color:0,bike:0,char:0,level:0},(()=>{try{return JSON.parse(localStorage.getItem('mhc_cfg'))||{}}catch(e){return{}}})());
const LV=()=>LEVELS[cfg.level]||LEVELS[0],BK=()=>BIKES[cfg.bike]||BIKES[0],CH=()=>CHARS[cfg.char]||CHARS[0];
const gar=Object.assign({coins:100,eng:0,fuel:0,ctl:0},(()=>{try{return JSON.parse(localStorage.getItem('mhc_gar'))||{}}catch(e){return{}}})());
function ground(x){const a=Math.min(1,Math.max(0,(x-500)/5000));return 460+a*LV().amp*(50*Math.sin(x/170)+22*Math.sin(x/60+1)+90*Math.sin(x/500))}
let s,gas=0,brk=0,wh=0,best=0,run=false;
try{best=+localStorage.getItem('mhc_best')||0}catch(e){}
function reset(){s={x:100,y:ground(100)-40,vx:0,vy:0,a:0,w:0,fuel:100,cams:0,picked:{},t:0,dead:false,ph:0};document.getElementById('best').textContent=(uname?uname+' · ':'')+'الأفضل: '+best}
reset();
const keys={};
function bind(id,set){const e=document.getElementById(id);const on=ev=>{ev.preventDefault();set(1);e.classList.add('on')},off=ev=>{ev.preventDefault();set(0);e.classList.remove('on')};e.addEventListener('pointerdown',on);['pointerup','pointercancel','pointerleave'].forEach(n=>e.addEventListener(n,off));e.addEventListener('contextmenu',ev=>ev.preventDefault())}
bind('gas',v=>gas=v);bind('brk',v=>brk=v);bind('whl',v=>wh=v);
addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='d')gas=1;if(e.key==='ArrowLeft'||e.key==='a')brk=1;if(e.key==='ArrowUp'||e.key==='w')wh=1});
addEventListener('keyup',e=>{if(e.key==='ArrowRight'||e.key==='d')gas=0;if(e.key==='ArrowLeft'||e.key==='a')brk=0;if(e.key==='ArrowUp'||e.key==='w')wh=0});
document.getElementById('go').onclick=()=>{try{AC=AC||new (window.AudioContext||window.webkitAudioContext)();AC.resume();initEng()}catch(e){}parts=[];G=LV().g;reset();document.getElementById('ov').style.display='none';run=true};
const wheels=[-26,26];
function step(dt){
 const b=s;
 let fx=0,fy=G,tq=0;
 const ca=Math.cos(b.a),sa=Math.sin(b.a);
 let grounded=false,fOn=false,rOn=false;
 const hasFuel=b.fuel>0&&!b.dead;
 for(const lx of wheels){
  const ly=14,rx=ca*lx-sa*ly,ry=sa*lx+ca*ly;
  const px=b.x+rx,py=b.y+ry;
  const gy=ground(px),pen=py+R-gy;
  if(pen>0){
   grounded=true;if(lx>0)fOn=true;else rOn=true;
   const sl=(ground(px+1)-ground(px-1))/2,nl=Math.hypot(sl,1);
   const tx=1/nl,ty=sl/nl,nx=sl/nl,ny=-1/nl;
   const vpx=b.vx-b.w*ry,vpy=b.vy+b.w*rx;
   const vn=vpx*nx+vpy*ny,vt=vpx*tx+vpy*ty;
   let Fn=Math.max(0,K*pen-C*vn);
   let Ft=-vt*1.2;
   if(lx<0){
    if(gas&&hasFuel&&vt<BK().max*(1+.05*gar.eng))Ft+=BK().eng*LV().tr*(1+.08*gar.eng);
    if(brk)Ft-=vt*9;
   } else if(brk)Ft-=vt*9;
   const Fx=Fn*nx+Ft*tx,Fy=Fn*ny+Ft*ty;
   fx+=Fx;fy+=Fy;tq+=rx*Fy-ry*Fx;
  }
 }
 if(rOn&&!fOn&&!b.dead&&b.a<-.2){b.wb=(b.wb||0)+dt}
 if(!grounded){if(gas&&hasFuel)tq-=5500*(1+.1*gar.ctl);if(brk)tq+=5500*(1+.1*gar.ctl);b.w*=0.995}
 if(wh&&hasFuel)tq-=(grounded?7500:3500)*(1+.1*gar.ctl);b.w+=tq/BK().I*dt;
 b.vx+=fx*dt;b.vy+=fy*dt;
 b.x+=b.vx*dt;b.y+=b.vy*dt;b.a+=b.w*dt;
 b.ph+=b.vx*dt/R;
 // head collision
 const hx=b.x+ca*4-sa*-32,hy=b.y+sa*4+ca*-32;
 if(!b.dead&&(hy+7>ground(hx)||b.a>2.6||b.a<-2.6))die();
}
function die(){
 if(s.dead)return;s.dead=true;run=false;const ca=Math.cos(s.a),sa=Math.sin(s.a);shake=14;thud(1);dust(s.x,ground(s.x),14);s.rd={x:s.x+ca*2+sa*20,y:s.y+sa*2-ca*20,vx:s.vx*1.05+60,vy:s.vy-180,a:s.a,w:(s.w>=0?1:-1)*7+s.w*.3,ph:0};
 const m=Math.max(0,Math.floor((s.x-100)/20));
 const wc=Math.floor((s.wb||0)*3);gar.coins+=Math.floor(m/8)+wc;saveGar();if(m>best){best=m;try{localStorage.setItem('mhc_best',m)}catch(e){}}
 setTimeout(()=>{document.getElementById('msg').textContent=(uname?uname+'، ':'')+'طحتي على راسك! المسافة: '+m+' م · ربحتي '+(Math.floor(m/8)+wc)+' عملة'+(wc?' (كابراج '+s.wb.toFixed(1)+' ث)':'');document.getElementById('go').textContent='عاود';buildMenu();document.getElementById('ov').style.display='flex'},1700);
}
function draw(){
 const T=s.rd||s;const camX=T.x-W*0.32,camY=T.y-H*0.58;
 const g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,LV().sky[0]);g.addColorStop(.6,LV().sky[1]);g.addColorStop(1,LV().sky[2]);
 ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
 // sun
 ctx.fillStyle=LV().sun;ctx.beginPath();ctx.arc(W*.78,H*.22,38,0,7);ctx.fill();
 // far dunes
 ctx.fillStyle=LV().far;ctx.beginPath();ctx.moveTo(0,H);
 for(let x=0;x<=W+20;x+=20){ctx.lineTo(x,H*.62+Math.sin((x+camX*.25)/140)*34+Math.sin((x+camX*.25)/55)*10)}
 ctx.lineTo(W,H);ctx.fill();
 // terrain
 ctx.beginPath();ctx.moveTo(0,H+50);
 for(let x=0;x<=W+10;x+=8){ctx.lineTo(x,ground(x+camX)-camY)}
 ctx.lineTo(W,H+50);ctx.closePath();
 ctx.fillStyle=LV().ground;ctx.fill();
 ctx.lineWidth=7;ctx.strokeStyle=LV().edge;ctx.beginPath();
 for(let x=0;x<=W+10;x+=8){const y=ground(x+camX)-camY;x?ctx.lineTo(x,y):ctx.moveTo(x,y)}
 ctx.stroke();
 // fuel cans
 const i0=Math.floor((camX-100)/1400),i1=Math.ceil((camX+W)/1400);
 for(let i=Math.max(1,i0);i<=i1;i++){
  if(s.picked[i])continue;
  const fx=i*1400,fy=ground(fx)-34-camY;
  ctx.fillStyle='#2f7d32';ctx.fillRect(fx-camX-9,fy-12,18,24);
  ctx.fillStyle='#fff6e8';ctx.fillRect(fx-camX-4,fy-5,8,10);
 }
 // bike
 ctx.save();ctx.translate(s.x-camX,s.y-camY);ctx.rotate(s.a);
 for(const lx of wheels){
  ctx.save();ctx.translate(lx,14);ctx.rotate(s.ph);
  ctx.fillStyle='#1d120c';ctx.beginPath();ctx.arc(0,0,R,0,7);ctx.fill();
  ctx.strokeStyle='#e8d6b8';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(-R+3,0);ctx.lineTo(R-3,0);ctx.moveTo(0,-R+3);ctx.lineTo(0,R-3);ctx.stroke();
  ctx.restore();
 }
 ctx.lineCap='round';ctx.lineJoin='round';
 ctx.strokeStyle=COLORS[cfg.color];ctx.lineWidth=7;ctx.beginPath();ctx.moveTo(-26,14);ctx.lineTo(-8,-4);ctx.lineTo(14,-4);ctx.lineTo(22,-14);ctx.stroke();
 ctx.lineWidth=5;ctx.beginPath();ctx.moveTo(14,-4);ctx.lineTo(26,14);ctx.stroke();deco(ctx);
 if(!s.dead){ctx.strokeStyle=CH().s;ctx.lineWidth=6;ctx.beginPath();ctx.moveTo(-4,-8);ctx.lineTo(2,-24);ctx.lineTo(4,-32);ctx.moveTo(2,-22);ctx.lineTo(20,-14);ctx.moveTo(-2,-6);ctx.lineTo(10,2);ctx.lineTo(14,14);ctx.stroke();
 ctx.fillStyle=CH().h;ctx.beginPath();ctx.arc(4,-33,8,0,7);ctx.fill();
 ctx.fillStyle=CH().t;ctx.beginPath();ctx.arc(4,-35,8,Math.PI,0);ctx.fill();}
 ctx.restore();
}
function stepRider(dt){
 const r=s.rd;if(!r)return;
 r.vy+=G*dt;r.x+=r.vx*dt;r.y+=r.vy*dt;r.a+=r.w*dt;
 r.ph+=dt*(8+Math.hypot(r.vx,r.vy)/40);
 const gy=ground(r.x);
 if(r.y+11>gy){
  r.y=gy-11;
  if(r.vy>0){if(r.vy>120){shake=Math.max(shake,Math.min(10,r.vy/60));thud(Math.min(1,r.vy/500));dust(r.x,gy,8)}r.vy*=-0.38;if(Math.abs(r.vy)<45)r.vy=0;r.w*=0.6}
  r.vx*=0.992;r.w*=0.985;
 }
}
function drawRider(){
 const r=s.rd;if(!r)return;
 const T=s.rd,camX=T.x-W*0.32,camY=T.y-H*0.58;
 const amp=Math.min(1,Math.hypot(r.vx,r.vy)/350),f=Math.sin(r.ph)*amp;
 ctx.save();ctx.translate(r.x-camX,r.y-camY);ctx.rotate(r.a);
 ctx.lineCap='round';ctx.strokeStyle=CH().s;
 ctx.lineWidth=7;ctx.beginPath();ctx.moveTo(0,-10);ctx.lineTo(0,7);ctx.stroke();
 ctx.lineWidth=5;ctx.beginPath();
