<canvas id="c"></canvas>
<div id="ld"><h1>موتور الجبل</h1><div class="bar"><i></i><b>🏍️</b></div><p>جاري التنزيل... <span id="lp">0%</span></p><div class="tip" id="lt"></div></div>
<script>
(function(){
 const ld=document.getElementById('ld'),bar=ld.querySelector('.bar i'),bk=ld.querySelector('.bar b'),pc=document.getElementById('lp'),tp=document.getElementById('lt');
 const tips=['استعمل الكابراج باش تربح عملات زايدات','ما تطيحش على راسك! استعمل الغاز والفرامل فالهوا','جمع البيدونات الخضر باش ما يساليش البنزين','طور الموتور فالكراج بالعملات'];
 const T=10000,t0=performance.now();
 function f(){
  const k=Math.min(1,(performance.now()-t0)/T);
  bar.style.width=(k*100)+'%';bk.style.left=(k*100)+'%';pc.textContent=Math.floor(k*100)+'%';
  tp.textContent=tips[Math.min(tips.length-1,Math.floor(k*tips.length))];
  if(k<1)requestAnimationFrame(f);
  else{ld.style.opacity=0;setTimeout(()=>{ld.style.display='none'},500)}
 }
 f();
})();
</script>
<div class="hud"><div class="pill" id="dist">0 م</div><div class="fuel"><i id="fb"></i></div><div class="pill" id="best">الأفضل: 0</div></div>
